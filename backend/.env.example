# Application environment for the FastAPI backend.
# Copy to .env and adjust values. NEVER commit the real .env file.

# --- PostgreSQL ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=portfolio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Built by the app from the parts above (optional override):
# DATABASE_URL=postgresql+psycopg2://portfolio:change_me_strong_password@db:5432/portfolio

# --- API ---
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional SMTP notifications (contact form email) ---
# Leave SMTP_HOST empty to skip email — messages are still stored in PostgreSQL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
