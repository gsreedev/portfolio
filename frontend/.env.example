# Base URL for the FastAPI backend.
# For a separately deployed frontend, set this to the public backend URL.
# Leave empty only when nginx or the Vite dev server proxies /api.
VITE_API_BASE_URL=

# Google Analytics 4 measurement ID (starts with G-).
# Create a property + web data stream at https://analytics.google.com to get it.
# Leave empty to disable analytics entirely.
VITE_GA_ID=
