# Project-root environment for docker compose.
# Copy to .env and adjust. NEVER commit the real .env file.

# Google Analytics 4 measurement ID (inlined into the frontend at build time).
# Get it from https://analytics.google.com → Admin → Data streams.
VITE_GA_ID=

# PostgreSQL (backend + db containers)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=portfolio

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
